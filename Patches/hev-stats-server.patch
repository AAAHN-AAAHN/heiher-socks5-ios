@@ -131,6 +131,44 @@ hev_socks5_server_quit (void)
     hev_socks5_proxy_stop ();
 }
 
+void
+hev_socks5_server_stats (uint64_t *received, uint64_t *sent)
+{
+    hev_socks5_transfer_get (received, sent);
+}
+
+typedef struct
+{
+    HevSocks5ClientStats *rows;
+    size_t capacity;
+} ClientStatsCopy;
+
+static void
+client_stats_copy (uint64_t id, const char *address, uint64_t received,
+                   uint64_t sent, void *data)
+{
+    ClientStatsCopy *copy = data;
+    HevSocks5ClientStats *row;
+
+    /* IDs are stable contiguous process-lifetime indices. If clients register
+     * between size query and copy, preserve older rows and return the new size. */
+    if (id >= copy->capacity)
+        return;
+    row = &copy->rows[id];
+    row->id = id;
+    row->received = received;
+    row->sent = sent;
+    snprintf (row->address, sizeof (row->address), "%s", address);
+}
+
+size_t
+hev_socks5_server_client_stats (HevSocks5ClientStats *rows, size_t capacity)
+{
+    ClientStatsCopy copy = { rows, capacity };
+
+    return hev_socks5_transfer_clients (rows ? client_stats_copy : NULL, &copy);
+}
+
 WEAK int
 main (int argc, char *argv[])
 {
