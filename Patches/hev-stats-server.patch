+/**
+ * hev_socks5_server_stats:
+ * @received: receives payload bytes read from external sockets
+ * @sent: receives payload bytes written to external sockets
+ *
+ * Thread-safe process-lifetime totals; retained across server restarts.
+ * Both output pointers must be non-NULL. Totals are sampled independently.
+ * Excludes SOCKS5 and transport headers; not peer acknowledgements or VPN bytes.
+ */
+void hev_socks5_server_stats (uint64_t *received, uint64_t *sent);
+
+/** A process-lifetime client IP bucket; id 0 is unattributed payload. */
+typedef struct
+{
+    uint64_t id;
+    uint64_t received;
+    uint64_t sent;
+    char address[64];
+} HevSocks5ClientStats;
+
+/**
+ * hev_socks5_server_client_stats:
+ * @rows: caller-owned storage, or NULL to query required capacity
+ * @capacity: number of rows available, ignored when rows is NULL
+ *
+ * Return the required row count, including id 0. Copy min(capacity, count)
+ * rows ordered by stable id. A larger return than capacity means newer rows
+ * did not fit; query again on the next sample. No internal pointer is returned.
+ * Totals survive server Stop/Start and use the same external-side payload
+ * boundary as hev_socks5_server_stats. IPs identify observed control peers,
+ * not devices behind NAT. Rows/counter pairs are sampled independently.
+ */
+size_t hev_socks5_server_client_stats (HevSocks5ClientStats *rows,
+                                       size_t capacity);
