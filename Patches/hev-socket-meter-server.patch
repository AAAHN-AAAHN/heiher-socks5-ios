+void
+hev_socks5_server_endpoint_stats (uint64_t *received, uint64_t *sent)
+{
+    hev_meter_totals (received, sent);
+}
+
+typedef struct
+{
+    HevSocks5EndpointStats *rows;
+    size_t capacity;
+    size_t copied;
+} ClientStatsCopy;
+
+static void
+client_stats_copy (uint64_t id, const char *address, uint64_t received,
+                   uint64_t sent, void *data)
+{
+    ClientStatsCopy *copy = data;
+    HevSocks5EndpointStats *row;
+
+    /* IDs are stable but CAS registration can leave gaps. Copy packed rows;
+     * callers retry a bounded snapshot if concurrent registrations do not fit. */
+    if (copy->copied >= copy->capacity)
+        return;
+    row = &copy->rows[copy->copied++];
+    row->id = id;
+    row->received = received;
+    row->sent = sent;
+    snprintf (row->address, sizeof (row->address), "%s", address);
+}
+
+size_t
+hev_socks5_server_endpoint_rows (HevSocks5EndpointStats *rows, size_t capacity)
+{
+    ClientStatsCopy copy = { rows, capacity, 0 };
+
+    return hev_meter_rows (rows ? client_stats_copy : NULL, &copy);
+}
+
