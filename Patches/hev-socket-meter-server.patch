+/* Socket boundary, peer viewpoint: received = bytes accepted TO this IP,
+ * sent = bytes consumed FROM this IP. Includes SOCKS framing/control bytes.
+ * Excludes OS-generated TCP/IP headers, ACKs and kernel retransmissions.
+ * Independent snapshots for the current server session; not IP packet octets.
+ * A new native run clears totals/rows. Failed init and a pre-start Stop retain
+ * the last session. Bracket related snapshots with the generation getter and
+ * discard them if its value changes. Generation zero precedes the first run. */
+typedef struct
+{
+    uint64_t id;
+    uint64_t received;
+    uint64_t sent;
+    char address[64];
+} HevSocks5EndpointStats;
+uint32_t hev_socks5_server_endpoint_generation (void);
+void hev_socks5_server_endpoint_stats (uint64_t *received, uint64_t *sent);
+/* Return required capacity (including Unattributed id 0), copy bounded rows.
+ * Rows use peer IP (either role), normalize IPv4-mapped IPv6, retain scope. */
+size_t hev_socks5_server_endpoint_rows (HevSocks5EndpointStats *rows,
+                                        size_t capacity);
+
 #ifdef __cplusplus
 }
 #endif
