+/* Inspect only a complete address, after validating its declared byte length.
+ * A length-prefixed name must not lose a suffix in the native string APIs. */
+static inline int
+hev_socks5_addr_has_nul (const HevSocks5Addr *addr)
+{
+    return addr->atype == HEV_SOCKS5_ADDR_TYPE_NAME &&
+           memchr (addr->domain.addr, 0, addr->domain.len) != NULL;
+}
