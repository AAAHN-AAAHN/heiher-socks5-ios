+typedef struct _UDPWorkspace UDPWorkspace;
+typedef struct _UDPPrefix UDPPrefix;
+
+/* Only the three prefix bytes are transmitted; addresses have their own iovec. */
+struct _UDPPrefix
+{
+    union
+    {
+        uint8_t rsv[3];
+        struct
+        {
+            uint16_t datlen;
+            uint8_t hdrlen;
+        } __attribute__ ((packed));
+    };
+} __attribute__ ((packed));
