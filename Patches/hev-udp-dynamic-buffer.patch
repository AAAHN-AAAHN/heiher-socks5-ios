+static uint64_t
+udp_buffer_now (void)
+{
+#if defined(__APPLE__)
+    return clock_gettime_nsec_np (CLOCK_MONOTONIC_RAW);
+#else
+    struct timespec ts;
+#if defined(CLOCK_BOOTTIME)
+    const clockid_t clock = CLOCK_BOOTTIME;
+#else
+    const clockid_t clock = CLOCK_MONOTONIC;
+#endif
+    /* Match the task timer's fail-closed clock policy. */
+    if (clock_gettime (clock, &ts) < 0)
+        abort ();
+    return (uint64_t)ts.tv_sec * UDP_NSEC_PER_SEC + ts.tv_nsec;
+#endif
+}
+
+static uint64_t
+udp_timeout_now (void)
+{
+    struct timespec ts;
+#if defined(__APPLE__) && defined(CLOCK_UPTIME_RAW)
+    const clockid_t clock = CLOCK_UPTIME_RAW;
+#else
+    const clockid_t clock = CLOCK_MONOTONIC;
+#endif
+    if (clock_gettime (clock, &ts) < 0)
+        abort ();
+    return (uint64_t)ts.tv_sec * UDP_NSEC_PER_SEC + ts.tv_nsec;
+}
+
+static size_t
+udp_buffer_bins (size_t capacity)
+{
+    return (capacity - UDP_BUF_SIZE) / UDP_BUFFER_GROW_STEP;
+}
+
+static void *
+udp_buffer_data (UDPBuffer *buffer)
+{
+    if (!buffer->history)
+        return buffer->base;
+    return buffer->history + udp_buffer_bins (buffer->capacity);
+}
+
+static int
+udp_buffer_round (size_t needed, size_t *capacity)
+{
+    size_t extra = (UDP_BUFFER_GROW_STEP - needed % UDP_BUFFER_GROW_STEP) %
+                   UDP_BUFFER_GROW_STEP;
+
+    if (needed > SIZE_MAX - extra) {
+        errno = EOVERFLOW;
+        return -1;
+    }
+    *capacity = needed <= UDP_BUF_SIZE ? UDP_BUF_SIZE : needed + extra;
+    return 0;
+}
+
+/* Only before receiving or after all I/O references have been released.
+ * Copy history, not stale payload. Allocation failure retains the old buffer. */
+static int
+udp_buffer_resize (UDPBuffer *buffer, size_t capacity)
+{
+    size_t bins = udp_buffer_bins (capacity);
+    size_t previous = udp_buffer_bins (buffer->capacity);
+    uint64_t *history;
+
+    if (capacity == buffer->capacity)
+        return 0;
+    if (capacity == UDP_BUF_SIZE) {
+        if (buffer->history)
+            hev_free (buffer->history);
+        buffer->history = NULL;
+        buffer->capacity = capacity;
+        return 0;
+    }
+    if (capacity > PTRDIFF_MAX ||
+        bins > (PTRDIFF_MAX - capacity) / sizeof (*history)) {
+        errno = EOVERFLOW;
+        return -1;
+    }
+    history = hev_malloc (capacity + bins * sizeof (*history));
+    if (!history) {
+        errno = ENOMEM;
+        return -1;
+    }
+    if (previous > bins)
+        previous = bins;
+    if (previous)
+        memcpy (history, buffer->history, previous * sizeof (*history));
+    memset (history + previous, 0, (bins - previous) * sizeof (*history));
+    if (buffer->history)
+        hev_free (buffer->history);
+    buffer->history = history;
+    buffer->capacity = capacity;
+    return 0;
+}
+
+static int
+udp_buffer_reserve (UDPBuffer *buffer, size_t needed)
+{
+    size_t capacity;
+
+    if (needed <= buffer->capacity)
+        return 0;
+    if (udp_buffer_round (needed, &capacity) < 0 ||
+        udp_buffer_resize (buffer, capacity) < 0)
+        return -1;
+    if (!buffer->owner->next_cleanup)
+        buffer->owner->next_cleanup =
+            udp_buffer_now () + UDP_BUFFER_CLEANUP_SECONDS * UDP_NSEC_PER_SEC;
+    return 0;
+}
+
+static void
+udp_buffer_used (UDPBuffer *buffer, size_t needed)
+{
+    size_t capacity;
+
+    if (needed <= UDP_BUF_SIZE)
+        return;
+    if (udp_buffer_round (needed, &capacity) == 0)
+        buffer->history[udp_buffer_bins (capacity) - 1] =
+            udp_buffer_now () + UDP_BUFFER_HOLD_SECONDS * UDP_NSEC_PER_SEC;
+}
+
+/* A zero expiry is unused. Each bucket stores only its last demand + HOLD. */
+static void
+udp_buffers_cleanup (UDPBuffers *buffers, uint64_t now)
+{
+    size_t i;
+    int retained = 0;
+
+    if (!buffers->next_cleanup || now < buffers->next_cleanup)
+        return;
+    for (i = 0; i < buffers->count; i++) {
+        UDPBuffer *buffer = &buffers->slots[i];
+        size_t bins = udp_buffer_bins (buffer->capacity);
+        while (bins) {
+            uint64_t expiry = buffer->history[bins - 1];
+            if (expiry > now)
+                break;
+            bins--;
+        }
+        /* A failed shrink is retried at the next sweep, not on every packet. */
+        udp_buffer_resize (buffer, UDP_BUF_SIZE + bins * UDP_BUFFER_GROW_STEP);
+        retained |= buffer->history != NULL;
+    }
+    buffers->next_cleanup =
+        retained ? now + UDP_BUFFER_CLEANUP_SECONDS * UDP_NSEC_PER_SEC : 0;
+}
+
+/* Query the next datagram, never the aggregate SO_RCVBUF queue size.
+ * The owner is the sole reader between this query and the nonblocking receive. */
+static ssize_t
+udp_buffer_datagram_size (int fd, UDPBuffer *buffer)
+{
+    (void)buffer;
+#if defined(__APPLE__)
+    int length = 0;
+    socklen_t size = sizeof (length);
+    char byte;
+
+    if (getsockopt (fd, SOL_SOCKET, SO_NREAD, &length, &size) < 0)
+        return -1;
+    if (!length) {
+        /* Distinguish an empty datagram from an empty queue, without consuming
+         * either. Requery if a datagram arrived after the first SO_NREAD. */
+        if (recv (fd, &byte, 1, MSG_PEEK | MSG_DONTWAIT) < 0)
+            return -1;
+        size = sizeof (length);
+        if (getsockopt (fd, SOL_SOCKET, SO_NREAD, &length, &size) < 0)
+            return -1;
+    }
+    if (length < 0 || size != sizeof (length)) {
+        errno = EIO;
+        return -1;
+    }
+    return length;
+#elif defined(__linux__)
+    return recv (fd, NULL, 0, MSG_PEEK | MSG_TRUNC | MSG_DONTWAIT);
+#else
+    /* Portable fallback only: do not assume Linux MSG_TRUNC return semantics.
+     * Probe growth is geometric; the final reservation is still a 500B multiple. */
+    for (;;) {
+        struct iovec iov = { udp_buffer_data (buffer), buffer->capacity };
+        struct msghdr msg = { 0 };
+        ssize_t length;
+        msg.msg_iov = &iov;
+        msg.msg_iovlen = 1;
+        length = recvmsg (fd, &msg, MSG_PEEK | MSG_DONTWAIT);
+        if (length < 0 || !(msg.msg_flags & MSG_TRUNC))
+            return length;
+        if (buffer->capacity > SIZE_MAX / 2) {
+            errno = EOVERFLOW;
+            return -1;
+        }
+        if (udp_buffer_reserve (buffer, buffer->capacity * 2) < 0)
+            return -1;
+    }
+#endif
+}
+
+static int
+udp_buffer_recvmmsg (HevSocks5UDP *self, int fd, struct mmsghdr *messages,
+                     unsigned int num, int flags, UDPBuffer *buffers)
+{
+    unsigned int i;
+
+    if (!buffers)
+        return hev_task_io_socket_recvmmsg (fd, messages, num, flags,
+                                            task_io_yielder, self);
+    for (i = 0; i < num; i++) {
+        struct msghdr *msg = &messages[i].msg_hdr;
+        ssize_t needed = udp_buffer_datagram_size (fd, &buffers[i]);
+        int res;
+
+        if (needed < 0)
+            return i ? (int)i : -1;
+        if (udp_buffer_reserve (&buffers[i], needed) < 0) {
+            /* Do not consume and forward a truncated prefix on allocation failure.
+             * Terminate this association, rather than spin on its queue head. */
+            hev_socks5_set_timeout (HEV_SOCKS5 (self), 0);
+            return i ? (int)i : -1;
+        }
+        msg->msg_iov[0].iov_base = udp_buffer_data (&buffers[i]);
+        msg->msg_iov[0].iov_len = buffers[i].capacity;
+        msg->msg_flags = 0;
+        res = hev_task_io_socket_recvmmsg (fd, &messages[i], 1, MSG_DONTWAIT,
+                                           task_io_yielder, self);
+        if (res <= 0)
+            return i ? (int)i : res;
+        if (!(msg->msg_flags & MSG_TRUNC) &&
+            messages[i].msg_len <= buffers[i].capacity)
+            udp_buffer_used (&buffers[i], messages[i].msg_len);
+        else
+            msg->msg_flags |= MSG_TRUNC;
+    }
+    return i;
+}
