+#define UDP_BUFFER_GROW_STEP 500
+#define UDP_BUFFER_HOLD_SECONDS (5 * 60)
+#define UDP_BUFFER_CLEANUP_SECONDS 60
+#define UDP_NSEC_PER_SEC UINT64_C (1000000000)
