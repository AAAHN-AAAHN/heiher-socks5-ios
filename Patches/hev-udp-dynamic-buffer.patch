+/* One relay owner reuses these arrays after each synchronous receive/send.
+ * Packed reply addresses remain separate from socket addresses during conversion. */
+struct _UDPWorkspace
+{
+    struct mmsghdr *messages;
+    struct iovec *iov;
+    HevSocks5UDPMsg *packets;
+    struct sockaddr_in6 *addresses;
+    unsigned char (*reply_addresses)[19];
+    UDPPrefix *prefixes;
+};
+
+/* One owner task. History precedes an optional contiguous replacement payload;
+ * neither payload nor history is allocated for individual packets. */
+struct _UDPBuffer
+{
+    void *base;
+    uint64_t *history;
+    size_t capacity;
+    UDPBuffers *owner;
+};
+
+struct _UDPBuffers
+{
+    UDPBuffer *slots;
+    size_t count;
+    uint64_t next_cleanup;
+    uint64_t idle_deadline;
+};
+
+/* Include alignment padding in every checked span, before allocating anything. */
+static int
+udp_workspace_span (size_t *size, size_t count, size_t unit, size_t alignment,
+                    size_t *offset)
+{
+    size_t padding = (alignment - *size % alignment) % alignment;
+
+    if (*size > (size_t)PTRDIFF_MAX - padding ||
+        count > ((size_t)PTRDIFF_MAX - *size - padding) / unit) {
+        errno = EOVERFLOW;
+        return -1;
+    }
+    *offset = *size + padding;
+    *size = *offset + count * unit;
+    return 0;
+}
+
+/* Optional adaptive slots share this allocation; the caller owns the returned
+ * base, while the workspace contains only typed views into it. */
+static void *
+udp_workspace_new (UDPWorkspace *workspace, size_t num, UDPBuffer **slots)
+{
+    size_t size = 0, offsets[7];
+    char *base;
+
+    if (num > INT_MAX) {
+        errno = EOVERFLOW;
+        return NULL;
+    }
+    if (!num) {
+        errno = EINVAL;
+        return NULL;
+    }
+    if (udp_workspace_span (&size, slots ? num : 0, sizeof (UDPBuffer) * 2,
+                            _Alignof (UDPBuffer), &offsets[0]) < 0 ||
+        udp_workspace_span (&size, num, sizeof (struct mmsghdr),
+                            _Alignof (struct mmsghdr), &offsets[1]) < 0 ||
+        udp_workspace_span (&size, num, sizeof (struct iovec) * 3,
+                            _Alignof (struct iovec), &offsets[2]) < 0 ||
+        udp_workspace_span (&size, num, sizeof (HevSocks5UDPMsg),
+                            _Alignof (HevSocks5UDPMsg), &offsets[3]) < 0 ||
+        udp_workspace_span (&size, num, sizeof (struct sockaddr_in6),
+                            _Alignof (struct sockaddr_in6), &offsets[4]) < 0 ||
+        udp_workspace_span (&size, num, 19, 1, &offsets[5]) < 0 ||
+        udp_workspace_span (&size, num, sizeof (UDPPrefix),
+                            _Alignof (UDPPrefix), &offsets[6]) < 0)
+        return NULL;
+    base = hev_malloc0 (size);
+    if (!base) {
+        errno = ENOMEM;
+        return NULL;
+    }
+    if (slots)
+        *slots = (UDPBuffer *)(base + offsets[0]);
+    workspace->messages = (struct mmsghdr *)(base + offsets[1]);
+    workspace->iov = (struct iovec *)(base + offsets[2]);
+    workspace->packets = (HevSocks5UDPMsg *)(base + offsets[3]);
+    workspace->addresses = (struct sockaddr_in6 *)(base + offsets[4]);
+    workspace->reply_addresses = (void *)(base + offsets[5]);
+    workspace->prefixes = (UDPPrefix *)(base + offsets[6]);
+    return base;
+}
