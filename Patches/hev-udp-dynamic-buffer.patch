+/* Called only at the outer relay boundary: no I/O owns a buffer here.
+ * Maintenance wakes must not restart the independent communication timeout. */
+static int
+udp_buffers_yield (HevTaskYieldType type, HevSocks5 *self, UDPBuffers *buffers)
+{
+    uint64_t now, deadline, remaining;
+    unsigned int delay, result;
+
+    if (!self->timeout)
+        return -1;
+    if (type == HEV_TASK_YIELD) {
+        buffers->idle_deadline = 0;
+        return task_io_yielder (type, self);
+    }
+    if (!buffers->next_cleanup && buffers->idle_deadline == UINT64_MAX)
+        buffers->idle_deadline = 0;
+    if (!buffers->next_cleanup && !buffers->idle_deadline)
+        return task_io_yielder (type, self);
+    if (udp_control_check (self) < 0)
+        return -1;
+    now = udp_buffer_now ();
+    if (!buffers->idle_deadline)
+        buffers->idle_deadline = self->timeout < 0 ?
+                                     UINT64_MAX :
+                                     now + (uint64_t)self->timeout * 1000000;
+    deadline = buffers->idle_deadline;
+    if (buffers->next_cleanup && buffers->next_cleanup < deadline)
+        deadline = buffers->next_cleanup;
+    if (now >= buffers->idle_deadline)
+        return -1;
+    if (now >= deadline)
+        return 0;
+    remaining = (deadline - now) / 1000000 + ((deadline - now) % 1000000 != 0);
+    delay = remaining > UINT_MAX ? UINT_MAX : (unsigned int)remaining;
+    result = hev_task_sleep (delay);
+    if (!self->timeout)
+        return -1;
+    if (udp_buffer_now () >= buffers->idle_deadline)
+        return -1;
+    if (result)
+        buffers->idle_deadline =
+            0; /* Actual I/O wake: retain prior wait policy. */
+    return 0;
+}
