+/* Darwin's UDP send high-water mark may be below a valid large datagram.
+ * Grow only that socket on EMSGSIZE, only if its limit is actually too small.
+ * No sysctl, eager reservation or per-packet getsockopt is introduced. */
+static int
+udp_sendmmsg (HevSocks5UDP *self, int fd, struct mmsghdr *messages,
+              unsigned int num)
+{
+    unsigned int done = 0;
+    int res;
+#if defined(__APPLE__)
+    unsigned int retried = UINT_MAX;
+#endif
+
+    do {
+        res = hev_task_io_socket_sendmmsg (fd, messages + done, num - done,
+                                           MSG_WAITALL, task_io_yielder, self);
+        if (res > 0)
+            done += res;
+#if defined(__APPLE__)
+        if (done < num && done != retried && errno == EMSGSIZE) {
+            struct msghdr *msg = &messages[done].msg_hdr;
+            size_t needed = 0;
+            int capacity;
+            socklen_t length = sizeof (capacity);
+            for (int i = 0; i < msg->msg_iovlen; i++) {
+                if (msg->msg_iov[i].iov_len > INT_MAX - needed)
+                    return done ? (int)done : -1;
+                needed += msg->msg_iov[i].iov_len;
+            }
+            if (getsockopt (fd, SOL_SOCKET, SO_SNDBUF, &capacity, &length) <
+                    0 ||
+                length != sizeof (capacity) || capacity < 0 ||
+                needed <= (size_t)capacity)
+                break;
+            capacity = (int)needed;
+            retried = done;
+            if (setsockopt (fd, SOL_SOCKET, SO_SNDBUF, &capacity,
+                            sizeof (capacity)) < 0)
+                break;
+            continue;
+        }
+#endif
+        break;
+    } while (done < num);
+    return done ? (int)done : res;
+}
