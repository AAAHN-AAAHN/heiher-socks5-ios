-        hev_task_yield (HEV_TASK_YIELD);
-        return 0;
-    }
-
-    if (self->timeout < 0) {
-        hev_task_yield (HEV_TASK_WAITIO);
-    } else {
-        int timeout = self->timeout;
-        timeout = hev_task_sleep (timeout);
