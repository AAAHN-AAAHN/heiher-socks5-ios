+void *
+hev_socks5_server_io_writer_new (void)
+{
+    return wm_worker_new ();
+}
+
+void
+hev_socks5_server_io_writer_record (void *writer,
+                                    const struct sockaddr *address,
+                                    socklen_t length, size_t accepted_write,
+                                    size_t consumed_read)
+{
+    int saved_errno = errno;
+
+    if (writer && (accepted_write || consumed_read))
+        wm_add (wm_peer (writer, address, length), accepted_write,
+                consumed_read);
+    errno = saved_errno;
+}
+
+void
+hev_socks5_server_io_writer_free (void *writer)
+{
+    wm_worker_release (writer);
+}
