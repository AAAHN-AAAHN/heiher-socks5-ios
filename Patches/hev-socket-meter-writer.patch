+/* A caller-owned single writer, independent of native worker TLS. Serialize
+ * record and free; join all callbacks before free. Totals survive release.
+ * Address is the actual socket peer. Directions retain the peer viewpoint:
+ * accepted_write -> received by the peer; consumed_read -> sent by the peer. */
+void *hev_socks5_server_io_writer_new (void);
+void hev_socks5_server_io_writer_record (void *writer,
+                                         const struct sockaddr *address,
+                                         socklen_t length,
+                                         size_t accepted_write,
+                                         size_t consumed_read);
+void hev_socks5_server_io_writer_free (void *writer);
+
