diff --git a/src/hev-socks5-proxy.c b/src/hev-socks5-proxy.c
--- a/src/hev-socks5-proxy.c
+++ b/src/hev-socks5-proxy.c
@@ -302,8 +302,10 @@
 {
     LOG_D ("socks5 proxy run");
 
-    if (atomic_fetch_and (&tsync, ~SYNC_STOP) & SYNC_STOP)
+    if (atomic_fetch_and (&tsync, ~SYNC_STOP) & SYNC_STOP) {
+        atomic_fetch_or (&tsync, SYNC_ABRT);
         return;
+    }
 
     atomic_fetch_or (&tsync, SYNC_CONT);
 
diff --git a/src/hev-socks5-worker.c b/src/hev-socks5-worker.c
--- a/src/hev-socks5-worker.c
+++ b/src/hev-socks5-worker.c
@@ -54,6 +54,10 @@
 task_io_yielder (HevTaskYieldType type, void *data)
 {
     HevSocks5Worker *self = data;
+
+    /* A pending Stop can run before this task reaches its first wait. */
+    if (!READ_ONCE (self->run))
+        return -1;
 
     hev_task_yield (type);
 
