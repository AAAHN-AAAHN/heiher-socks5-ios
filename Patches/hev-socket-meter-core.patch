diff --git a/src/hev-socks5-meter.c b/src/hev-socks5-meter.c
new file mode 100644
index 0000000..05d2277
--- /dev/null
+++ b/src/hev-socks5-meter.c
@@ -0,0 +1,158 @@
+/* One process/socket metric. Workers own counter writes; readers only sample. */
+#include <errno.h>
+#include <pthread.h>
+#include "hev-socks5.h"
+#include "hev-socks5-meter.h"
+#include "worker_meter.h"
+
+static pthread_key_t meter_key;
+/* The single engine initializes this before creating any worker threads. */
+static int meter_key_ready;
+static void
+meter_release (void *p)
+{
+    wm_worker_release (p);
+}
+
+int
+hev_meter_prepare (void)
+{
+    if (meter_key_ready)
+        return 0;
+    if (pthread_key_create (&meter_key, meter_release))
+        return -1;
+    meter_key_ready = 1;
+    return 0;
+}
+
+int
+hev_meter_worker_enter (void)
+{
+    WmWorker *worker = pthread_getspecific (meter_key);
+    if (worker)
+        return 0;
+    worker = wm_worker_new ();
+    if (!worker)
+        return -1;
+    if (pthread_setspecific (meter_key, worker)) {
+        wm_worker_release (worker);
+        return -1;
+    }
+    return 0;
+}
+
+void
+hev_meter_worker_leave (void)
+{
+    WmWorker *worker = pthread_getspecific (meter_key);
+    /* If clearing fails, keep ownership until the thread-key destructor. */
+    if (!pthread_setspecific (meter_key, NULL))
+        wm_worker_release (worker);
+}
+
+void *
+hev_meter_peer (const struct sockaddr *address, socklen_t length)
+{
+    int error = errno;
+    void *peer = wm_peer (pthread_getspecific (meter_key), address, length);
+    errno = error;
+    return peer;
+}
+
+void *
+hev_meter_fd (int fd)
+{
+    struct sockaddr_storage address = { 0 };
+    socklen_t length = sizeof (address);
+    int error = errno;
+    void *peer = getpeername (fd, (struct sockaddr *)&address, &length) < 0 ?
+                     NULL :
+                     hev_meter_peer ((struct sockaddr *)&address, length);
+    errno = error;
+    return peer;
+}
+
+void
+hev_meter_add (void *peer, size_t in, size_t out)
+{
+    if (!peer)
+        peer = wm_unknown (pthread_getspecific (meter_key));
+    wm_add (peer, in, out);
+}
+
+void
+hev_meter_totals (uint64_t *in, uint64_t *out)
+{
+    wm_snapshot (NULL, NULL, in, out);
+}
+
+size_t
+hev_meter_rows (HevMeterRow callback, void *context)
+{
+    return wm_snapshot (callback, context, NULL, NULL);
+}
+
+void
+hev_meter_stream (const size_t bytes[4], void *context)
+{
+    void **endpoints = context;
+    hev_meter_add (endpoints[0], bytes[1], bytes[0]);
+    hev_meter_add (endpoints[1], bytes[3], bytes[2]);
+}
+
+static void
+socket_observer (int fd, const struct msghdr *msg, size_t bytes, int writing,
+                 void *context)
+{
+    HevSocks5 *self = context;
+    void *peer = self->io_peer;
+    if (msg && msg->msg_name)
+        peer = hev_meter_peer (msg->msg_name, msg->msg_namelen);
+    /* Only connected control streams/client relay sends have no msg_name.
+     * Unconnected receive always provides the actual sender before filtering. */
+    hev_meter_add (peer, writing ? bytes : 0, writing ? 0 : bytes);
+}
+
+/* Preserve the parent's timeout, short I/O, cancellation and errno behaviour. */
+ssize_t
+hev_meter_recv (int fd, void *buf, size_t len, int flags,
+                HevTaskIOYielder yielder, void *self)
+{
+    return hev_task_io_socket_recv_observed (fd, buf, len, flags, yielder, self,
+                                             socket_observer, self);
+}
+ssize_t
+hev_meter_send (int fd, const void *buf, size_t len, int flags,
+                HevTaskIOYielder yielder, void *self)
+{
+    return hev_task_io_socket_send_observed (fd, buf, len, flags, yielder, self,
+                                             socket_observer, self);
+}
+ssize_t
+hev_meter_recvmsg (int fd, struct msghdr *msg, int flags,
+                   HevTaskIOYielder yielder, void *self)
+{
+    return hev_task_io_socket_recvmsg_observed (fd, msg, flags, yielder, self,
+                                                socket_observer, self);
+}
+ssize_t
+hev_meter_sendmsg (int fd, const struct msghdr *msg, int flags,
+                   HevTaskIOYielder yielder, void *self)
+{
+    return hev_task_io_socket_sendmsg_observed (fd, msg, flags, yielder, self,
+                                                socket_observer, self);
+}
+int
+hev_meter_recvmmsg (int fd, void *messages, unsigned int count, int flags,
+                    HevTaskIOYielder yielder, void *self)
+{
+    return hev_task_io_socket_recvmmsg_observed (
+        fd, messages, count, flags, yielder, self, socket_observer, self);
+}
+int
+hev_meter_sendmmsg (int fd, void *messages, unsigned int count, int flags,
+                    HevTaskIOYielder yielder, void *self)
+{
+    return hev_task_io_socket_sendmmsg_observed (
+        fd, messages, count, flags, yielder, self, socket_observer, self);
+}
diff --git a/src/hev-socks5-meter.h b/src/hev-socks5-meter.h
new file mode 100644
index 0000000..8bf8c33
--- /dev/null
+++ b/src/hev-socks5-meter.h
@@ -0,0 +1,37 @@
+/* Program/socket boundary accounting; not IP packet or interface counters. */
+#ifndef HEV_SOCKS5_METER_H
+#define HEV_SOCKS5_METER_H
+#include <stdint.h>
+#include <stddef.h>
+#include <sys/socket.h>
+#include <hev-task.h>
+#include <hev-task-io.h>
+#include <hev-task-io-socket.h>
+
+/* Rows are remote endpoints: In = OS accepted bytes TO peer;
+ * Out = bytes consumed FROM peer. Nodes live until process exit. */
+typedef void (*HevMeterRow) (uint64_t id, const char *address, uint64_t in,
+                             uint64_t out, void *context);
+int hev_meter_prepare (void);
+int hev_meter_worker_enter (void);
+void hev_meter_worker_leave (void);
+void *hev_meter_peer (const struct sockaddr *address, socklen_t length);
+void *hev_meter_fd (int fd);
+void hev_meter_add (void *peer, size_t in, size_t out);
+void hev_meter_totals (uint64_t *in, uint64_t *out);
+size_t hev_meter_rows (HevMeterRow callback, void *context);
+void hev_meter_stream (const size_t bytes[4], void *context);
+
+ssize_t hev_meter_recv (int fd, void *buf, size_t len, int flags,
+                        HevTaskIOYielder yielder, void *self);
+ssize_t hev_meter_send (int fd, const void *buf, size_t len, int flags,
+                        HevTaskIOYielder yielder, void *self);
+ssize_t hev_meter_recvmsg (int fd, struct msghdr *msg, int flags,
+                           HevTaskIOYielder yielder, void *self);
+ssize_t hev_meter_sendmsg (int fd, const struct msghdr *msg, int flags,
+                           HevTaskIOYielder yielder, void *self);
+int hev_meter_recvmmsg (int fd, void *messages, unsigned int count, int flags,
+                        HevTaskIOYielder yielder, void *self);
+int hev_meter_sendmmsg (int fd, void *messages, unsigned int count, int flags,
+                        HevTaskIOYielder yielder, void *self);
+#endif
