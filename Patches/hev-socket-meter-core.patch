+#include <sys/socket.h>
+
+typedef struct WmWorker WmWorker;
+typedef struct WmPeer WmPeer;
+typedef void (*WmVisit) (uint64_t id, const char *address, uint64_t in,
+                         uint64_t out, void *context);
+/* One writer per worker. Create/register workers before their first socket I/O.
+ * Workers and peer references live for the process lifetime. No callback yields.
+ * Snapshot rows are individually coherent, not a global simultaneous instant. */
+WmWorker *wm_worker_new (void);
+void wm_worker_release (WmWorker *);
+WmPeer *wm_peer (WmWorker *, const struct sockaddr *, socklen_t);
+WmPeer *wm_unknown (WmWorker *);
+void wm_add (WmPeer *, size_t accepted_write, size_t consumed_read);
+size_t wm_snapshot (WmVisit, void *, uint64_t *in, uint64_t *out);
