diff --git a/src/worker_meter.c b/src/worker_meter.c
new file mode 100644
index 0000000..cebdb69
--- /dev/null
+++ b/src/worker_meter.c
@@ -0,0 +1,279 @@
+#include "worker_meter.h"
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <limits.h>
+
+/* No mutex, compiler TLS, atomic uint64_t, or per-I/O shared RMW. */
+_Static_assert (sizeof (unsigned) >= 4, "32-bit unsigned required");
+typedef struct Identity Identity;
+typedef struct
+{
+    _Atomic unsigned sequence, epoch, in_lo, in_hi, out_lo, out_hi;
+    unsigned version, epoch_value;
+    uint64_t in, out; /* Written exclusively by the owning worker. */
+} Counter;
+struct WmPeer
+{
+    struct WmPeer *bucket_next, *identity_next;
+    Identity *identity;
+    Counter counter;
+};
+struct Identity
+{
+    Identity *next;
+    _Atomic (WmPeer *) parts;
+    uint64_t id;
+    uint32_t scope;
+    int family;
+    unsigned char ip[16];
+    char address[64];
+};
+struct WmWorker
+{
+    struct WmWorker *next;
+    _Atomic unsigned owned;
+    WmPeer *buckets[256];
+    WmPeer unknown;
+};
+static _Atomic (WmWorker *) worker_pool;
+static _Atomic (Identity *) identities[256];
+static _Atomic unsigned serial;
+static Identity unknown = { .address = "Unattributed" };
+
+static void
+counter_init (Counter *c)
+{
+    atomic_init (&c->sequence, 0);
+    atomic_init (&c->epoch, 0);
+    atomic_init (&c->in_lo, 0);
+    atomic_init (&c->in_hi, 0);
+    atomic_init (&c->out_lo, 0);
+    atomic_init (&c->out_hi, 0);
+}
+static void
+publish_part (WmPeer *p, Identity *identity)
+{
+    p->identity = identity;
+    WmPeer *head =
+        atomic_load_explicit (&identity->parts, memory_order_relaxed);
+    do {
+        p->identity_next = head;
+    } while (!atomic_compare_exchange_weak_explicit (&identity->parts, &head, p,
+                                                     memory_order_release,
+                                                     memory_order_relaxed));
+}
+WmWorker *
+wm_worker_new (void)
+{
+    WmWorker *head = atomic_load_explicit (&worker_pool, memory_order_acquire);
+    for (WmWorker *p = head; p; p = p->next) {
+        unsigned vacant = 0;
+        if (atomic_compare_exchange_strong_explicit (&p->owned, &vacant, 1,
+                                                     memory_order_acquire,
+                                                     memory_order_relaxed))
+            return p;
+    }
+    WmWorker *w = calloc (1, sizeof (*w));
+    if (!w)
+        return NULL;
+    atomic_init (&w->owned, 1);
+    counter_init (&w->unknown.counter);
+    publish_part (&w->unknown, &unknown);
+    do {
+        w->next = head;
+    } while (!atomic_compare_exchange_weak_explicit (
+        &worker_pool, &head, w, memory_order_release, memory_order_relaxed));
+    return w;
+}
+void
+wm_worker_release (WmWorker *w)
+{
+    if (w)
+        atomic_store_explicit (&w->owned, 0, memory_order_release);
+}
+WmPeer *
+wm_unknown (WmWorker *w)
+{
+    return w ? &w->unknown : NULL;
+}
+static int
+same (const Identity *id, int family, uint32_t scope,
+      const unsigned char ip[16])
+{
+    return id->family == family && id->scope == scope &&
+           !memcmp (id->ip, ip, 16);
+}
+WmPeer *
+wm_peer (WmWorker *w, const struct sockaddr *addr, socklen_t length)
+{
+    unsigned char ip[16] = { 0 };
+    uint32_t scope = 0, hash = 2166136261u;
+    int family;
+    if (!w)
+        return NULL;
+    if (!addr || length < offsetof (struct sockaddr, sa_family) +
+                              sizeof (addr->sa_family))
+        return &w->unknown;
+    family = addr->sa_family;
+    if (family == AF_INET && length >= sizeof (struct sockaddr_in)) {
+        memcpy (ip, &((const struct sockaddr_in *)addr)->sin_addr, 4);
+    } else if (family == AF_INET6 && length >= sizeof (struct sockaddr_in6)) {
+        const struct sockaddr_in6 *v6 = (const struct sockaddr_in6 *)addr;
+        if (IN6_IS_ADDR_V4MAPPED (&v6->sin6_addr)) {
+            family = AF_INET;
+            memcpy (ip, v6->sin6_addr.s6_addr + 12, 4);
+        } else {
+            memcpy (ip, &v6->sin6_addr, 16);
+            scope = v6->sin6_scope_id;
+        }
+    } else
+        return &w->unknown;
+    for (unsigned i = 0; i < 16; i++)
+        hash = (hash ^ ip[i]) * 16777619u;
+    hash = (hash ^ scope ^ (unsigned)family) & 255u;
+    for (WmPeer *p = w->buckets[hash]; p; p = p->bucket_next)
+        if (same (p->identity, family, scope, ip))
+            return p;
+    Identity *id;
+    for (;;) {
+        Identity *head =
+            atomic_load_explicit (&identities[hash], memory_order_acquire);
+        for (id = head; id; id = id->next)
+            if (same (id, family, scope, ip))
+                break;
+        if (id)
+            break;
+        Identity *fresh = calloc (1, sizeof (*fresh));
+        if (!fresh)
+            return &w->unknown;
+        char text[INET6_ADDRSTRLEN];
+        if (!inet_ntop (family, ip, text, sizeof (text))) {
+            free (fresh);
+            return &w->unknown;
+        }
+        /* IDs may have holes after a lost insertion race; snapshots never index
+         * the caller's array by ID. No ID wrap may silently alias an older IP. */
+        unsigned n = atomic_load_explicit (&serial, memory_order_relaxed);
+        do {
+            if (n == UINT_MAX) {
+                free (fresh);
+                return &w->unknown;
+            }
+        } while (!atomic_compare_exchange_weak_explicit (
+            &serial, &n, n + 1, memory_order_relaxed, memory_order_relaxed));
+        fresh->id = (uint64_t)n + 1;
+        fresh->family = family;
+        fresh->scope = scope;
+        memcpy (fresh->ip, ip, 16);
+        if (scope)
+            snprintf (fresh->address, sizeof (fresh->address), "%s%%%u", text,
+                      scope);
+        else
+            snprintf (fresh->address, sizeof (fresh->address), "%s", text);
+        atomic_init (&fresh->parts, NULL);
+        fresh->next = head;
+        if (atomic_compare_exchange_strong_explicit (
+                &identities[hash], &head, fresh, memory_order_release,
+                memory_order_relaxed)) {
+            id = fresh;
+            break;
+        }
+        free (fresh);
+    }
+    WmPeer *p = calloc (1, sizeof (*p));
+    if (!p)
+        return &w->unknown;
+    counter_init (&p->counter);
+    p->bucket_next = w->buckets[hash];
+    w->buckets[hash] = p;
+    publish_part (p, id);
+    return p;
+}
+void
+wm_add (WmPeer *peer, size_t in, size_t out)
+{
+    if (!peer || (!in && !out))
+        return;
+    Counter *c = &peer->counter;
+    c->in += in;
+    c->out += out;
+    atomic_store_explicit (&c->sequence, ++c->version, memory_order_relaxed);
+    atomic_thread_fence (memory_order_release);
+    atomic_store_explicit (&c->in_lo, (unsigned)(uint32_t)c->in,
+                           memory_order_relaxed);
+    atomic_store_explicit (&c->in_hi, (unsigned)(c->in >> 32),
+                           memory_order_relaxed);
+    atomic_store_explicit (&c->out_lo, (unsigned)(uint32_t)c->out,
+                           memory_order_relaxed);
+    atomic_store_explicit (&c->out_hi, (unsigned)(c->out >> 32),
+                           memory_order_relaxed);
+    if (++c->version == 0)
+        atomic_store_explicit (&c->epoch, ++c->epoch_value,
+                               memory_order_relaxed);
+    atomic_store_explicit (&c->sequence, c->version, memory_order_release);
+}
+static void
+counter_read (const Counter *c, uint64_t *in, uint64_t *out)
+{
+    for (;;) {
+        unsigned generation =
+            atomic_load_explicit (&c->epoch, memory_order_relaxed);
+        unsigned before =
+            atomic_load_explicit (&c->sequence, memory_order_acquire);
+        if (before & 1u)
+            continue;
+        unsigned il = atomic_load_explicit (&c->in_lo, memory_order_relaxed);
+        unsigned ih = atomic_load_explicit (&c->in_hi, memory_order_relaxed);
+        unsigned ol = atomic_load_explicit (&c->out_lo, memory_order_relaxed);
+        unsigned oh = atomic_load_explicit (&c->out_hi, memory_order_relaxed);
+        atomic_thread_fence (memory_order_acquire);
+        if (before !=
+                atomic_load_explicit (&c->sequence, memory_order_relaxed) ||
+            generation !=
+                atomic_load_explicit (&c->epoch, memory_order_relaxed))
+            continue;
+        *in = ((uint64_t)ih << 32) | il;
+        *out = ((uint64_t)oh << 32) | ol;
+        return;
+    }
+}
+static void
+identity_read (Identity *id, WmVisit visit, void *context, uint64_t *in,
+               uint64_t *out)
+{
+    uint64_t a = 0, b = 0;
+    for (WmPeer *p = atomic_load_explicit (&id->parts, memory_order_acquire); p;
+         p = p->identity_next) {
+        uint64_t x, y;
+        counter_read (&p->counter, &x, &y);
+        a += x;
+        b += y;
+    }
+    *in += a;
+    *out += b;
+    if (visit)
+        visit (id->id, id->address, a, b, context);
+}
+size_t
+wm_snapshot (WmVisit visit, void *context, uint64_t *in, uint64_t *out)
+{
+    uint64_t a = 0, b = 0;
+    size_t count = 1;
+    identity_read (&unknown, visit, context, &a, &b);
+    for (unsigned i = 0; i < 256; i++)
+        for (Identity *id =
+                 atomic_load_explicit (&identities[i], memory_order_acquire);
+             id; id = id->next) {
+            identity_read (id, visit, context, &a, &b);
+            ++count;
+        }
+    if (in)
+        *in = a;
+    if (out)
+        *out = b;
+    return count;
+}
