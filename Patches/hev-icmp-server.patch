diff --git a/src/hev-socks5-icmp.h b/src/hev-socks5-icmp.h
new file mode 100644
index 0000000000000000000000000000000000000000..e8cf8e53213513f8c7c93b3ac7472e60c122565c
--- /dev/null
+++ b/src/hev-socks5-icmp.h
@@ -0,0 +1,114 @@
+#ifndef HEV_SOCKS5_ICMP_PUBLIC_H
+#define HEV_SOCKS5_ICMP_PUBLIC_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/socket.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Local C API; it introduces no SOCKS wire command. Input/output buffers are
+ * ICMP messages (the 8-byte Echo header and payload), without an IP header.
+ * All functions are thread safe. A zero generation means the native worker
+ * is not ready. A client belongs to exactly one server generation. */
+typedef struct _HevSocks5IcmpClient HevSocks5IcmpClient;
+
+enum
+{
+    HEV_SOCKS5_ICMP_SENT = 1,
+    HEV_SOCKS5_ICMP_REPLY = 2,
+    HEV_SOCKS5_ICMP_ERROR = 3,
+};
+
+enum
+{
+    HEV_SOCKS5_ICMP_ERROR_NONE,
+    HEV_SOCKS5_ICMP_ERROR_LOCAL,
+    HEV_SOCKS5_ICMP_ERROR_RECEIVED,
+    HEV_SOCKS5_ICMP_ERROR_TIMEOUT,
+    HEV_SOCKS5_ICMP_ERROR_CANCELLED,
+    HEV_SOCKS5_ICMP_ERROR_SHUTDOWN,
+};
+
+typedef struct
+{
+    uint64_t request_id;
+    int event;
+    int error;
+    struct sockaddr_storage source;
+    struct sockaddr_storage destination;
+    socklen_t source_len;
+    socklen_t destination_len;
+    const unsigned char *echo;
+    size_t echo_len;
+    int error_origin;
+    unsigned char icmp_type;
+    unsigned char icmp_code;
+    uint32_t icmp_info;
+} HevSocks5IcmpResult;
+
+/* Callbacks run serially on native worker 0. Result/echo storage is borrowed
+ * until return. SENT means accepted by the OS; REPLY requires an actual Echo
+ * Reply. ERROR is terminal. error_origin distinguishes local errno, received
+ * ICMP, timeout, cancellation and shutdown; only RECEIVED has icmp_type/code
+ * and icmp_info (MTU or parameter pointer, host order, zero if unavailable).
+ * On RECEIVED, source is the actual error origin when known; destination is
+ * the logical return recipient, or the local address when available. The
+ * original request target remains associated with request_id, not source.
+ * Errors have no echo bytes; a quoted request is never a successful reply.
+ * Callbacks must not block, destroy a client, or stop/join the server. */
+typedef void (*HevSocks5IcmpCallback) (const HevSocks5IcmpResult *result,
+                                       void *context);
+/* A received network error with an unknown offender has peer=NULL and
+ * peer_len=0: its actual copied bytes are unattributed, not the target's.
+ * Linux error-queue reads count returned quoted Echo bytes, never invented
+ * outer headers; locally generated error records add no network reads. */
+typedef void (*HevSocks5IcmpObserver) (const struct sockaddr *peer,
+                                       socklen_t peer_len, size_t bytes,
+                                       int writing, void *context);
+
+uint64_t hev_socks5_server_icmp_generation (void);
+HevSocks5IcmpClient *hev_socks5_server_icmp_client_new (
+    uint64_t generation, HevSocks5IcmpCallback callback, void *context);
+
+/* Return 0 when copied/accepted, otherwise a negative errno without callback.
+ * Source identifies the original client for an already received message; it
+ * is not an instruction to spoof the outgoing IP source. NULL is allowed for
+ * a local request. Identifier, sequence and payload are restored in replies.
+ * timeout_ms is 1..60000; echo_len is 8..65515 (IPv4) or 8..65535 (IPv6).
+ * Pending requests and bytes are bounded; -EAGAIN means the caller should retry later, without busy looping. */
+int hev_socks5_server_icmp_submit (HevSocks5IcmpClient *client,
+                                   uint64_t request_id,
+                                   const struct sockaddr *source,
+                                   socklen_t source_len,
+                                   const struct sockaddr *destination,
+                                   socklen_t destination_len, const void *echo,
+                                   size_t echo_len, uint32_t timeout_ms);
+int hev_socks5_server_icmp_ping (HevSocks5IcmpClient *client,
+                                 uint64_t request_id,
+                                 const struct sockaddr *destination,
+                                 socklen_t destination_len,
+                                 uint32_t timeout_ms);
+
+/* Cancels requests accepted before the call. The client remains reusable.
+ * After return those requests cannot start another send. Free also waits for
+ * any active callback and guarantees no subsequent access to its context.
+ * The caller must serialize free against its own other uses of the pointer. */
+void hev_socks5_server_icmp_cancel (HevSocks5IcmpClient *client);
+void hev_socks5_server_icmp_client_free (HevSocks5IcmpClient *client);
+
+/* Configure while stopped. Called synchronously on worker 0 immediately after
+ * positive OS I/O, before reply validation/cancellation. NULL disables it.
+ * The observer must not block or reenter any ICMP API: send observation may
+ * hold the native admission lock. Internal API transfers are never counted.
+ * Returns -EBUSY while running. */
+int hev_socks5_server_icmp_set_io_observer (HevSocks5IcmpObserver observer,
+                                            void *context);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
