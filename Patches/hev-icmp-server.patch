+#ifndef HEV_ICMP_SERVER_H
+#define HEV_ICMP_SERVER_H
+
+/* Native lifecycle only. prepare/stop may run outside the worker; start is
+ * called by worker 0 after its listener has been registered successfully. */
+void hev_socks5_icmp_prepare (void);
+int hev_socks5_icmp_start (void);
+void hev_socks5_icmp_stop (void);
+void hev_socks5_icmp_request_stop (void);
+
+#endif
