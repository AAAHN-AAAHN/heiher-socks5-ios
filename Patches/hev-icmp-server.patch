index 0000000000000000000000000000000000000000..5507759187d9f7bdb0d10c0cdf4d39df8a6f931c
--- /dev/null
+++ b/src/hev-icmp-server.c
@@ -0,0 +1,627 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <arpa/inet.h>
+#include <net/if.h>
+
+#include <hev-task.h>
+#include <hev-icmp-engine.h>
+#include "hev-main.h"
+#include "hev-config.h"
+#include "hev-misc.h"
+#include "hev-icmp-server.h"
+
+#define CLIENT_LIMIT 1024
+#define QUEUE_BATCH 256
+
+_Static_assert (
+    (int)HEV_ICMP_ERROR_NONE == (int)HEV_SOCKS5_ICMP_ERROR_NONE &&
+        (int)HEV_ICMP_ERROR_LOCAL == (int)HEV_SOCKS5_ICMP_ERROR_LOCAL &&
+        (int)HEV_ICMP_ERROR_RECEIVED == (int)HEV_SOCKS5_ICMP_ERROR_RECEIVED &&
+        (int)HEV_ICMP_ERROR_TIMEOUT == (int)HEV_SOCKS5_ICMP_ERROR_TIMEOUT &&
+        (int)HEV_ICMP_ERROR_CANCELLED == (int)HEV_SOCKS5_ICMP_ERROR_CANCELLED &&
+        (int)HEV_ICMP_ERROR_SHUTDOWN == (int)HEV_SOCKS5_ICMP_ERROR_SHUTDOWN,
+    "ICMP error origins must retain the public API mapping");
+
+typedef struct _Submission Submission;
+typedef struct _IcmpServer IcmpServer;
+
+struct _HevSocks5IcmpClient
+{
+    uint64_t generation;
+    uint64_t epoch;
+    unsigned int refs;
+    unsigned int callbacks;
+    int closed;
+    HevSocks5IcmpCallback callback;
+    void *context;
+};
+
+struct _Submission
+{
+    Submission *next;
+    HevSocks5IcmpClient *client;
+    HevIcmpRequest *request;
+    uint64_t request_id;
+    uint64_t epoch;
+};
+
+struct _IcmpServer
+{
+    uint64_t generation;
+    int running;
+    int ready;
+    int wake_pending;
+    int fds[2];
+    size_t requests;
+    size_t bytes;
+    Submission *first;
+    Submission *last;
+    HevIcmpEngine *engine;
+    HevSocks5IcmpObserver observer;
+    void *observer_context;
+    struct sockaddr_storage bind[2];
+    int bind_error[2];
+    unsigned int interface;
+    const char *interface_name;
+    int mark;
+};
+
+static pthread_mutex_t gate = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t callbacks_done = PTHREAD_COND_INITIALIZER;
+static IcmpServer *current;
+static uint64_t generations;
+static unsigned int clients;
+static atomic_int permitted;
+static HevSocks5IcmpObserver configured_observer;
+static void *configured_context;
+
+static void
+client_unref (HevSocks5IcmpClient *client)
+{
+    if (!--client->refs) {
+        clients--;
+        free (client);
+    }
+}
+
+static void
+wake_locked (IcmpServer *s)
+{
+    const char byte = 1;
+    ssize_t n;
+    if (s->wake_pending)
+        return;
+    s->wake_pending = 1;
+    do {
+        n = write (s->fds[1], &byte, 1);
+    } while (n < 0 && errno == EINTR);
+    /* A full nonblocking pipe is already readable. Its lifetime is protected
+     * by gate, so the write cannot race a close/reused descriptor. */
+}
+
+uint64_t
+hev_socks5_server_icmp_generation (void)
+{
+    uint64_t generation;
+    pthread_mutex_lock (&gate);
+    generation = current && current->ready && current->running &&
+                         atomic_load (&permitted) ?
+                     current->generation :
+                     0;
+    pthread_mutex_unlock (&gate);
+    return generation;
+}
+
+HevSocks5IcmpClient *
+hev_socks5_server_icmp_client_new (uint64_t generation,
+                                   HevSocks5IcmpCallback callback,
+                                   void *context)
+{
+    HevSocks5IcmpClient *client = NULL;
+    pthread_mutex_lock (&gate);
+    if (!generation || !callback) {
+        errno = EINVAL;
+    } else if (!atomic_load (&permitted) || !current || !current->running ||
+               !current->ready || current->generation != generation) {
+        errno = ENOTCONN;
+    } else if (clients >= CLIENT_LIMIT) {
+        errno = ENOBUFS;
+    } else if ((client = calloc (1, sizeof (*client)))) {
+        client->generation = generation;
+        client->refs = 1;
+        client->callback = callback;
+        client->context = context;
+        clients++;
+    }
+    pthread_mutex_unlock (&gate);
+    return client;
+}
+
+int
+hev_socks5_server_icmp_submit (HevSocks5IcmpClient *client, uint64_t request_id,
+                               const struct sockaddr *source,
+                               socklen_t source_len,
+                               const struct sockaddr *destination,
+                               socklen_t destination_len, const void *echo,
+                               size_t echo_len, uint32_t timeout_ms)
+{
+    HevIcmpRequest *request;
+    Submission *submission;
+    IcmpServer *s;
+    int error = 0;
+    if (!client)
+        return -EINVAL;
+    pthread_mutex_lock (&gate);
+    s = current;
+    if (client->closed || !atomic_load (&permitted) || !s || !s->running ||
+        !s->ready || client->generation != s->generation) {
+        error = ENOTCONN;
+        goto exit;
+    }
+    if (echo_len > HEV_ICMP_BYTE_LIMIT ||
+        s->requests >= HEV_ICMP_REQUEST_LIMIT ||
+        echo_len > HEV_ICMP_BYTE_LIMIT - s->bytes) {
+        error = EAGAIN;
+        goto exit;
+    }
+    submission = calloc (1, sizeof (*submission));
+    if (!submission) {
+        error = ENOMEM;
+        goto exit;
+    }
+    request = hev_icmp_request_new (source, source_len, destination,
+                                    destination_len, echo, echo_len, timeout_ms,
+                                    submission);
+    if (!request) {
+        error = errno;
+        free (submission);
+        goto exit;
+    }
+    submission->client = client;
+    submission->epoch = client->epoch;
+    submission->request_id = request_id;
+    submission->request = request;
+    client->refs++;
+    s->requests++;
+    s->bytes += echo_len;
+    if (s->last)
+        s->last->next = submission;
+    else
+        s->first = submission;
+    s->last = submission;
+    wake_locked (s);
+exit:
+    pthread_mutex_unlock (&gate);
+    return -error;
+}
+
+int
+hev_socks5_server_icmp_ping (HevSocks5IcmpClient *client, uint64_t request_id,
+                             const struct sockaddr *destination,
+                             socklen_t destination_len, uint32_t timeout_ms)
+{
+    struct sockaddr_storage address;
+    unsigned char echo[8];
+    int len = hev_icmp_address (&address, destination, destination_len);
+    if (len <= 0)
+        return len ? len : -EINVAL;
+    hev_icmp_echo (echo, address.ss_family, request_id);
+    return hev_socks5_server_icmp_submit (client, request_id, NULL, 0,
+                                          (void *)&address, len, echo,
+                                          sizeof (echo), timeout_ms);
+}
+
+void
+hev_socks5_server_icmp_cancel (HevSocks5IcmpClient *client)
+{
+    if (!client)
+        return;
+    pthread_mutex_lock (&gate);
+    client->epoch++;
+    if (current && current->generation == client->generation)
+        wake_locked (current);
+    pthread_mutex_unlock (&gate);
+}
+
+void
+hev_socks5_server_icmp_client_free (HevSocks5IcmpClient *client)
+{
+    if (!client)
+        return;
+    pthread_mutex_lock (&gate);
+    client->closed = 1;
+    client->epoch++;
+    if (current && current->generation == client->generation)
+        wake_locked (current);
+    while (client->callbacks)
+        pthread_cond_wait (&callbacks_done, &gate);
+    client_unref (client);
+    pthread_mutex_unlock (&gate);
+}
+
+int
+hev_socks5_server_icmp_set_io_observer (HevSocks5IcmpObserver observer,
+                                        void *context)
+{
+    int res = 0;
+    pthread_mutex_lock (&gate);
+    if (current || atomic_load (&permitted)) {
+        res = -EBUSY;
+    } else {
+        configured_observer = observer;
+        configured_context = context;
+    }
+    pthread_mutex_unlock (&gate);
+    return res;
+}
+
+static void
+observe (const struct sockaddr *peer, socklen_t peer_len, size_t bytes,
+         int writing, void *context)
+{
+    IcmpServer *s = context;
+    int saved_errno = errno;
+    if (s->observer)
+        s->observer (peer, peer_len, bytes, writing, s->observer_context);
+    errno = saved_errno;
+}
+
+static int
+active (void *context)
+{
+    Submission *submission = context;
+    HevSocks5IcmpClient *c = submission->client;
+    int result;
+    pthread_mutex_lock (&gate);
+    result = !c->closed && c->epoch == submission->epoch && current &&
+             current->running && atomic_load (&permitted) &&
+             c->generation == current->generation;
+    pthread_mutex_unlock (&gate);
+    return result;
+}
+
+static void
+notify (IcmpServer *s, Submission *submission, int event, int error,
+        const struct sockaddr *peer, socklen_t peer_len,
+        const struct sockaddr *local, socklen_t local_len,
+        const unsigned char *echo, size_t len)
+{
+    HevSocks5IcmpClient *client = submission->client;
+    HevSocks5IcmpResult result = { 0 };
+    int deliver;
+    result.request_id = submission->request_id;
+    result.event = event;
+    result.error = error;
+    result.echo = echo;
+    result.echo_len = len;
+    if (event == HEV_SOCKS5_ICMP_ERROR) {
+        HevIcmpRequest *r = submission->request;
+        result.error_origin =
+            r->error_origin    ? r->error_origin :
+            error == ECANCELED ? HEV_SOCKS5_ICMP_ERROR_CANCELLED :
+            error == ESHUTDOWN ? HEV_SOCKS5_ICMP_ERROR_SHUTDOWN :
+                                 HEV_SOCKS5_ICMP_ERROR_LOCAL;
+        result.icmp_type = r->icmp_type;
+        result.icmp_code = r->icmp_code;
+        result.icmp_info = r->icmp_info;
+    }
+    if (peer && peer_len <= sizeof (result.source)) {
+        memcpy (&result.source, peer, peer_len);
+        result.source_len = peer_len;
+    }
+    if (local && local_len <= sizeof (result.destination)) {
+        memcpy (&result.destination, local, local_len);
+        result.destination_len = local_len;
+    }
+    pthread_mutex_lock (&gate);
+    deliver = !client->closed;
+    if (event != HEV_SOCKS5_ICMP_SENT &&
+        (client->epoch != submission->epoch || !s->running ||
+         !atomic_load (&permitted))) {
+        int running = s->running && atomic_load (&permitted);
+        result.event = HEV_SOCKS5_ICMP_ERROR;
+        result.error = running ? ECANCELED : ESHUTDOWN;
+        result.error_origin = running ? HEV_SOCKS5_ICMP_ERROR_CANCELLED :
+                                        HEV_SOCKS5_ICMP_ERROR_SHUTDOWN;
+        result.icmp_type = result.icmp_code = 0;
+        result.icmp_info = 0;
+        result.source_len = result.destination_len = 0;
+        result.echo = NULL;
+        result.echo_len = 0;
+    }
+    if (deliver)
+        client->callbacks++;
+    pthread_mutex_unlock (&gate);
+    if (deliver)
+        client->callback (&result, client->context);
+    pthread_mutex_lock (&gate);
+    if (deliver) {
+        client->callbacks--;
+        pthread_cond_broadcast (&callbacks_done);
+    }
+    if (event != HEV_SOCKS5_ICMP_SENT) {
+        s->requests--;
+        s->bytes -= submission->request->len;
+        client_unref (client);
+        free (submission);
+    }
+    pthread_mutex_unlock (&gate);
+}
+
+static void
+complete (HevIcmpRequest *request, int error, const struct sockaddr *peer,
+          socklen_t peer_len, const struct sockaddr *local, socklen_t local_len,
+          const unsigned char *echo, size_t len, void *context)
+{
+    notify (context, request->context,
+            error ? HEV_SOCKS5_ICMP_ERROR : HEV_SOCKS5_ICMP_REPLY, error, peer,
+            peer_len, local, local_len, echo, len);
+}
+
+static void
+prepare_bind (IcmpServer *s)
+{
+    int i;
+    s->interface_name = hev_config_get_bind_interface ();
+    if (s->interface_name)
+        s->interface = if_nametoindex (s->interface_name);
+    s->mark = hev_config_get_socket_mark ();
+    for (i = 0; i < 2; i++) {
+        const char *name = hev_config_get_bind_address (i ? AF_INET6 : AF_INET);
+        struct sockaddr_in6 address = { 0 };
+        if (i)
+            ((struct sockaddr_in6 *)&s->bind[i])->sin6_family = AF_INET6;
+        else
+            ((struct sockaddr_in *)&s->bind[i])->sin_family = AF_INET;
+        if (!name)
+            continue;
+        if (hev_netaddr_resolve (&address, name, NULL) < 0 ||
+            !!IN6_IS_ADDR_V4MAPPED (&address.sin6_addr) == !!i) {
+            s->bind_error[i] = EADDRNOTAVAIL;
+        } else if (i) {
+            memcpy (&s->bind[i], &address, sizeof (address));
+        } else {
+            struct sockaddr_in *v4 = (void *)&s->bind[i];
+            memcpy (&v4->sin_addr, &address.sin6_addr.s6_addr[12], 4);
+        }
+    }
+}
+
+static int
+bind_socket (int fd, int family, uint16_t identifier, void *context)
+{
+    IcmpServer *s = context;
+    int index = family == AF_INET6;
+    struct sockaddr_storage address = s->bind[index];
+    socklen_t len = index ? sizeof (struct sockaddr_in6) :
+                            sizeof (struct sockaddr_in);
+#ifdef __APPLE__
+    if (index)
+        ((struct sockaddr_in6 *)&address)->sin6_len = len;
+    else
+        ((struct sockaddr_in *)&address)->sin_len = len;
+#endif
+    if (s->bind_error[index]) {
+        errno = s->bind_error[index];
+        return -1;
+    }
+#ifdef __linux__
+    if (index)
+        ((struct sockaddr_in6 *)&address)->sin6_port = htons (identifier);
+    else
+        ((struct sockaddr_in *)&address)->sin_port = htons (identifier);
+#else
+    (void)identifier;
+#endif
+    if (bind (fd, (void *)&address, len) < 0) {
+#ifdef __linux__
+        if (errno != EADDRINUSE)
+            return -1;
+        if (index)
+            ((struct sockaddr_in6 *)&address)->sin6_port = 0;
+        else
+            ((struct sockaddr_in *)&address)->sin_port = 0;
+        if (bind (fd, (void *)&address, len) < 0)
+            return -1;
+#else
+        return -1;
+#endif
+    }
+    if (s->interface_name) {
+#ifdef __APPLE__
+        if (!s->interface) {
+            errno = ENODEV;
+            return -1;
+        }
+        if (setsockopt (fd, index ? IPPROTO_IPV6 : IPPROTO_IP,
+                        index ? IPV6_BOUND_IF : IP_BOUND_IF, &s->interface,
+                        sizeof (s->interface)) < 0)
+            return -1;
+#else
+        if (set_sock_bind (fd, s->interface_name) < 0)
+            return -1;
+#endif
+    }
+    return s->mark ? set_sock_mark (fd, s->mark) : 0;
+}
+
+static void
+server_task (void *context)
+{
+    IcmpServer *s = context;
+    HevTask *task = hev_task_self ();
+    prepare_bind (s);
+    pthread_mutex_lock (&gate);
+    s->ready = s->running && atomic_load (&permitted);
+    if (!s->ready)
+        s->running = 0;
+    pthread_mutex_unlock (&gate);
+    for (;;) {
+        unsigned int i;
+        int running, queued, blocked = 0;
+        char bytes[64];
+        while (read (s->fds[0], bytes, sizeof (bytes)) > 0)
+            ;
+        pthread_mutex_lock (&gate);
+        s->wake_pending = 0;
+        pthread_mutex_unlock (&gate);
+        for (i = 0; i < QUEUE_BATCH; i++) {
+            Submission *submission;
+            HevIcmpRequest *request;
+            int res;
+            pthread_mutex_lock (&gate);
+            submission = s->first;
+            if (!submission) {
+                pthread_mutex_unlock (&gate);
+                break;
+            }
+            request = submission->request;
+            if (!atomic_load (&permitted))
+                s->running = 0;
+            if (!s->running)
+                res = -ESHUTDOWN;
+            else if (submission->client->closed ||
+                     submission->epoch != submission->client->epoch)
+                res = -ECANCELED;
+            else
+                res = hev_icmp_engine_send (s->engine, request);
+            if (res == HEV_ICMP_DEFERRED || res == HEV_ICMP_RETRY) {
+                blocked = res;
+                pthread_mutex_unlock (&gate);
+                break;
+            }
+            s->first = submission->next;
+            if (!s->first)
+                s->last = NULL;
+            pthread_mutex_unlock (&gate);
+            notify (s, submission,
+                    res ? HEV_SOCKS5_ICMP_ERROR : HEV_SOCKS5_ICMP_SENT,
+                    res ? -res : 0, NULL, 0, (void *)&request->destination,
+                    request->destination_len, NULL, res ? 0 : request->len);
+            if (res)
+                free (request);
+        }
+        hev_icmp_engine_poll (s->engine, active);
+        pthread_mutex_lock (&gate);
+        running = s->running;
+        queued = s->first != NULL;
+        pthread_mutex_unlock (&gate);
+        if (!running && !queued)
+            break;
+        if (queued && (!blocked || blocked == HEV_ICMP_RETRY)) {
+            hev_task_yield (HEV_TASK_YIELD);
+        } else {
+            int timeout = hev_icmp_engine_timeout (s->engine);
+            if (queued && timeout < 0)
+                hev_task_yield (HEV_TASK_YIELD);
+            else if (timeout < 0)
+                hev_task_yield (HEV_TASK_WAITIO);
+            else
+                hev_task_sleep (timeout);
+        }
+    }
+    hev_icmp_engine_free (s->engine);
+    hev_task_del_fd (task, s->fds[0]);
+    pthread_mutex_lock (&gate);
+    current = NULL;
+    close (s->fds[0]);
+    close (s->fds[1]);
+    free (s);
+    pthread_mutex_unlock (&gate);
+}
+
+void
+hev_socks5_icmp_prepare (void)
+{
+    pthread_mutex_lock (&gate);
+    atomic_store (&permitted, 1);
+    pthread_mutex_unlock (&gate);
+}
+
+int
+hev_socks5_icmp_start (void)
+{
+    IcmpServer *s;
+    HevTask *task;
+    int i, error = ENOMEM;
+    pthread_mutex_lock (&gate);
+    if (!atomic_load (&permitted) || current) {
+        pthread_mutex_unlock (&gate);
+        return -1;
+    }
+    s = calloc (1, sizeof (*s));
+    if (!s)
+        goto fail;
+    s->fds[0] = s->fds[1] = -1;
+    if (pipe (s->fds) < 0) {
+        error = errno;
+        goto fail;
+    }
+    for (i = 0; i < 2; i++) {
+        if (fcntl (s->fds[i], F_SETFL, O_NONBLOCK) < 0 ||
+            fcntl (s->fds[i], F_SETFD, FD_CLOEXEC) < 0) {
+            error = errno;
+            goto fail;
+        }
+    }
+    s->engine = hev_icmp_engine_new (bind_socket, observe, complete, s);
+    if (!s->engine)
+        goto fail;
+    task = hev_task_new (65536);
+    if (!task)
+        goto fail;
+    if (hev_task_add_fd (task, s->fds[0], POLLIN) < 0) {
+        error = errno;
+        hev_task_unref (task);
+        goto fail;
+    }
+    if (!++generations)
+        ++generations;
+    s->generation = generations;
+    s->running = 1;
+    s->observer = configured_observer;
+    s->observer_context = configured_context;
+    current = s;
+    hev_task_run (task, server_task, s);
+    pthread_mutex_unlock (&gate);
+    return 0;
+fail:
+    if (s) {
+        if (s->fds[0] >= 0)
+            close (s->fds[0]);
+        if (s->fds[1] >= 0)
+            close (s->fds[1]);
+        hev_icmp_engine_free (s->engine);
+        free (s);
+    }
+    pthread_mutex_unlock (&gate);
+    errno = error;
+    return -1;
+}
+
+void
+hev_socks5_icmp_stop (void)
+{
+    pthread_mutex_lock (&gate);
+    atomic_store (&permitted, 0);
+    if (current) {
+        current->running = 0;
+        current->ready = 0;
+        wake_locked (current);
+    }
+    pthread_mutex_unlock (&gate);
+}
+
+void
+hev_socks5_icmp_request_stop (void)
+{
+    /* Called from the existing proxy stop/signal path. Worker 0 performs
+     * the mutex/descriptor shutdown after its stop event is delivered. */
+    atomic_store (&permitted, 0);
+}
