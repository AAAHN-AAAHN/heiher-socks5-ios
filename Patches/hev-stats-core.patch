 static int udp_recv_buffer_size = 512 * 1024;
 static int udp_copy_buffer_nums = 10;
 
+/* Registry entries are process-lived: relay callbacks never take the registry
+ * lock or follow pointers that a closing connection could free. */
+typedef struct _TrafficClient TrafficClient;
+struct _TrafficClient
+{
+    TrafficClient *bucket_next;
+    TrafficClient *next;
+    uint64_t id;
+    unsigned char ip[16];
+    uint32_t scope;
+    int family;
+    char address[64];
+    _Atomic uint64_t received;
+    _Atomic uint64_t sent;
+};
+
+static _Atomic uint64_t traffic_received;
+static _Atomic uint64_t traffic_sent;
+static TrafficClient traffic_unknown = { .address = "Unattributed" };
+static pthread_mutex_t traffic_lock = PTHREAD_MUTEX_INITIALIZER;
+static TrafficClient *traffic_buckets[256];
+static TrafficClient *traffic_clients;
+static size_t traffic_client_count;
+
+void *
+hev_socks5_transfer_client (int fd)
+{
+    struct sockaddr_storage peer = { 0 };
+    socklen_t length = sizeof (peer);
+    unsigned char ip[16] = { 0 };
+    char address[INET6_ADDRSTRLEN];
+    uint32_t scope = 0, hash = 2166136261u;
+    TrafficClient *client;
+    int family;
+    size_t i;
+
+    /* This is the SOCKS control peer, never the requested destination. */
+    if (getpeername (fd, (struct sockaddr *)&peer, &length) < 0)
+        return NULL;
+    family = peer.ss_family;
+    if (family == AF_INET && length >= sizeof (struct sockaddr_in)) {
+        memcpy (ip, &((struct sockaddr_in *)&peer)->sin_addr, 4);
+    } else if (family == AF_INET6 && length >= sizeof (struct sockaddr_in6)) {
+        const struct sockaddr_in6 *addr = (const struct sockaddr_in6 *)&peer;
+        if (IN6_IS_ADDR_V4MAPPED (&addr->sin6_addr)) {
+            family = AF_INET;
+            memcpy (ip, &addr->sin6_addr.s6_addr[12], 4);
+        } else {
+            memcpy (ip, &addr->sin6_addr, 16);
+            scope = addr->sin6_scope_id;
+        }
+    } else {
+        return NULL;
+    }
+    if (!inet_ntop (family, ip, address, sizeof (address)))
+        return NULL;
+    for (i = 0; i < sizeof (ip); i++)
+        hash = (hash ^ ip[i]) * 16777619u;
+    hash = (hash ^ scope ^ (uint32_t)family) & 255u;
+
+    pthread_mutex_lock (&traffic_lock);
+    for (client = traffic_buckets[hash]; client; client = client->bucket_next) {
+        if (client->family == family && client->scope == scope &&
+            !memcmp (client->ip, ip, sizeof (ip)))
+            break;
+    }
+    if (!client && traffic_client_count < SIZE_MAX - 1) {
+        /* libc allocation deliberately outlives task-system/server shutdown. */
+        client = calloc (1, sizeof (*client));
+        if (client) {
+            client->id = ++traffic_client_count;
+            client->family = family;
+            client->scope = scope;
+            memcpy (client->ip, ip, sizeof (ip));
+            if (scope)
+                snprintf (client->address, sizeof (client->address), "%s%%%u",
+                          address, scope);
+            else
+                snprintf (client->address, sizeof (client->address), "%s",
+                          address);
+            atomic_init (&client->received, 0);
+            atomic_init (&client->sent, 0);
+            client->next = traffic_clients;
+            client->bucket_next = traffic_buckets[hash];
+            traffic_buckets[hash] = client;
+            traffic_clients = client;
+        }
+    }
+    pthread_mutex_unlock (&traffic_lock);
+    return client;
+}
+
+void
+hev_socks5_transfer_add (size_t received, size_t sent, void *data)
+{
+    TrafficClient *client = data ? data : &traffic_unknown;
+
+    if (received) {
+        atomic_fetch_add_explicit (&traffic_received, received,
+                                   memory_order_relaxed);
+        atomic_fetch_add_explicit (&client->received, received,
+                                   memory_order_relaxed);
+    }
+    if (sent) {
+        atomic_fetch_add_explicit (&traffic_sent, sent, memory_order_relaxed);
+        atomic_fetch_add_explicit (&client->sent, sent, memory_order_relaxed);
+    }
+}
+
+void
+hev_socks5_transfer_get (uint64_t *received, uint64_t *sent)
+{
+    *received = atomic_load_explicit (&traffic_received, memory_order_relaxed);
+    *sent = atomic_load_explicit (&traffic_sent, memory_order_relaxed);
+}
+
+size_t
+hev_socks5_transfer_clients (HevSocks5TransferClient callback, void *data)
+{
+    TrafficClient *client;
+    size_t count;
+
+    pthread_mutex_lock (&traffic_lock);
+    client = traffic_clients;
+    count = traffic_client_count + 1;
+    pthread_mutex_unlock (&traffic_lock);
+    if (!callback)
+        return count;
+
+    /* The captured list and strings never change. Do not call user code locked.
+     * Counter pairs/rows are independent reads, not a transactional snapshot. */
+    callback (
+        0, traffic_unknown.address,
+        atomic_load_explicit (&traffic_unknown.received, memory_order_relaxed),
+        atomic_load_explicit (&traffic_unknown.sent, memory_order_relaxed),
+        data);
+    for (; client; client = client->next) {
+        callback (
+            client->id, client->address,
+            atomic_load_explicit (&client->received, memory_order_relaxed),
+            atomic_load_explicit (&client->sent, memory_order_relaxed), data);
+    }
+    return count;
+}
+
