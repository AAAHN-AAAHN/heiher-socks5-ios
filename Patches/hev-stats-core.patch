 static int udp_copy_buffer_nums = 10;
 
+static _Atomic uint64_t traffic_received;
+static _Atomic uint64_t traffic_sent;
+
+void
+hev_socks5_transfer_add (size_t received, size_t sent, void *data)
+{
+    (void)data;
+    if (received)
+        atomic_fetch_add_explicit (&traffic_received, received,
+                                   memory_order_relaxed);
+    if (sent)
+        atomic_fetch_add_explicit (&traffic_sent, sent, memory_order_relaxed);
+}
+
+void
+hev_socks5_transfer_get (uint64_t *received, uint64_t *sent)
+{
+    *received = atomic_load_explicit (&traffic_received, memory_order_relaxed);
+    *sent = atomic_load_explicit (&traffic_sent, memory_order_relaxed);
+}
+
