+static void
+socket_observed (HevTaskSocketObserver observer, int fd,
+                 const struct msghdr *msg, ssize_t count, int writing,
+                 int flags, void *context)
+{
+    size_t bytes = count, capacity = 0;
+    int error = errno;
+    if (!observer || count <= 0 || (!writing && (flags & MSG_PEEK)))
+        return;
+    if (!writing && msg) {
+        for (size_t i = 0; i < msg->msg_iovlen; i++)
+            capacity += msg->msg_iov[i].iov_len;
+        if (bytes > capacity)
+            bytes = capacity;
+    }
+    observer (fd, msg, bytes, writing, context);
+    errno = error;
+}
