+                                          HevTaskSocketObserver observer,
+                                          void *context);
+ssize_t hev_task_io_socket_recvmsg_observed (
+    int fd, struct msghdr *msg, int flags, HevTaskIOYielder yielder,
+    void *yielder_data, HevTaskSocketObserver observer, void *context);
+ssize_t hev_task_io_socket_sendmsg_observed (
+    int fd, const struct msghdr *msg, int flags, HevTaskIOYielder yielder,
+    void *yielder_data, HevTaskSocketObserver observer, void *context);
+int hev_task_io_socket_recvmmsg_observed (int fd, void *_msgv, unsigned int n,
+                                          int flags, HevTaskIOYielder yielder,
+                                          void *yielder_data,
+                                          HevTaskSocketObserver observer,
+                                          void *context);
+int hev_task_io_socket_sendmmsg_observed (int fd, void *_msgv, unsigned int n,
+                                          int flags, HevTaskIOYielder yielder,
+                                          void *yielder_data,
+                                          HevTaskSocketObserver observer,
+                                          void *context);
+
 #ifdef __cplusplus
 }
 #endif
